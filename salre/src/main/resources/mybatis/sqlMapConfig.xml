<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

	<settings>
		<setting name="logImpl" value="LOG4J" />
		<!-- mapper에서 null값이 왔을때 칼럼의 해당 타입임을 설정한다. 
		   이 설정이 없으면 #{email,jdbcType=VARCHAR}), #{salary, jdbcType=INTEGER}		   
		 -->
		<setting name="jdbcTypeForNull" value="NULL" />
	</settings>
	
	<!-- Mapper에서 사용, type이 너무 길기 때문에 alias로 대신해줌 -->
	<typeAliases><typeAlias type="com.salre.main.product.ProductDTO" alias="productVO" /> 
		<typeAlias type="com.salre.main.product.RegionDTO" alias="regionVO"/>
		<typeAlias type="com.salre.main.loan.LoanDTO" alias="loanDTO" />
		<typeAlias type="com.salre.main.notification.NotificationDTO" alias="notificationDTO" />
	</typeAliases>

</configuration>