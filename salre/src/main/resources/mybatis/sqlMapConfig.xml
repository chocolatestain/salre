<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
	<settings>
		<setting name="logImpl" value="LOG4J" />
		<setting name="jdbcTypeForNull" value="NULL" />
	</settings>
	<typeAliases>
		<typeAlias type="com.salre.main.contract.ContractDTO"
			alias="contractVO" />
		<typeAlias type="com.salre.main.contract.ContractUserDTO"
			alias="contractuserVO" />
		<typeAlias type="com.salre.main.product.ProductContractDTO"
			alias="productcontractVO" />
		<typeAlias type="com.salre.main.login.UserDTO"
			alias="userVO" />
		<typeAlias type="com.salre.main.product.ProductDTO"
			alias="productVO" />
		<!-- Mapper에서 사용, type이 너무 길기 때문에 alias로 대신해줌 -->
		<typeAlias type="com.salre.main.board.BoardDTO"
			alias="boardDTO" />
		<typeAlias type="com.salre.main.board.CommentDTO"
			alias="commentDTO" />
		<typeAlias type="com.salre.main.board.PageDTO"
			alias="pageDTO" />
		<typeAlias type="com.salre.main.product.RegionDTO"
			alias="regionVO" />
		<typeAlias type="com.salre.main.myPage.PostDTO"
			alias="PostDTO" />
		<typeAlias type="com.salre.main.myPage.ReviewDTO"
			alias="ReviewDTO" />
		<typeAlias type="com.salre.main.myPage.ReportDTO"
			alias="ReportDTO" />
	</typeAliases>
</configuration>