<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salre.comment">
	<insert id="register" parameterType="commentDTO">
		INSERT INTO COMMENT(board_id, comment_content) VALUES(#{board_id}, #{comment_content})
	</insert>
	
	<select id="selectAll" parameterType="Integer" resultType="commentDTO">
		SELECT * FROM COMMENT WHERE BOARD_ID = #{board_id} ORDER BY 1 DESC;
	</select>
</mapper>