<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salre.main.chat">
	<select id="checkDupChatRoom" parameterType="chatRoomDTO" resultType="Integer">
		SELECT COUNT(*) FROM CHATROOM WHERE user_id = #{user_id} AND room_name = #{room_name}
	</select>

	<insert id="createChatRoom" parameterType="chatRoomDTO">
		INSERT INTO CHATROOM(user_id, room_name) VALUES(#{user_id}, #{room_name})
	</insert>
	
	<select id="selectByUserId" parameterType="Integer" resultType="chatRoomDTO">
		SELECT * FROM CHATROOM WHERE user_id = #{user_id}
	</select>
	
	<select id="selectByChatRoomId" parameterType="Integer" resultType="chatRoomDTO">
		SELECT * FROM CHATROOM WHERE chatRoom_id = #{chatRoom_id}
	</select>
</mapper>