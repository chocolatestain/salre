<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace : 이름공간(group), 다른 mapper의 id와 중복시 구분하기 위함 -->
<mapper namespace="com.salre.main.contract">

	<select id="selectAll" resultType="contractVO">
		select *
		from contract
		order by 1
	</select>
	<select id="selectById" parameterType="int" resultType="contractVO">
		select *
		from contract
		where contract_id = #{aa}
	</select>
	<select id="selectContractPById" parameterType="int" resultType="productcontractVO">
		select * 
		from contract
		join product  using (product_id)
		where contract_id = #{aa}
	</select>
	<!-- <select id="selectSellerById" parameterType="int" resultType="contractVO">
		select *
		from contract
		join user on contract.user_id = user.user_id
		where contract_id = #{aa}
	</select> -->
	<insert id="insert" parameterType="contractVO">
		insert into contract (contract_id,user_id,product_id,price,account,contract_status)
		values(
		#{contract_id},
		#{user_id},
		#{product_id},
		#{price},
		#{account},
		#{contract_status})
	</insert>
	<update id="update" parameterType="contractVO">
		update contract
		set user_id = #{user_id},
			product_id = #{product_id}
			price = #{price}
			account = #{account}
			contract_status = #{contract_status}
		where contract_id = #{contract_id}
	</update>
	<delete id = "delete" parameterType="int">
		delete from contract where contract_id = #{did}
	</delete>
</mapper>